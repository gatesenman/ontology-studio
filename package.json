{
  "name": "ontology-studio",
  "version": "0.1.0",
  "private": true,
  "description": "Palantir-style ontology semantic modeling desktop app: object types, properties, link types, action types, value types, metrics, and rules, with built-in ontology testing.",
  "type": "module",
  "main": "electron/main.cjs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "dev:desktop": "concurrently -k \"vite\" \"wait-on tcp:5173 && electron .\"",
    "build": "tsc --noEmit -p tsconfig.app.json && vite build",
    "start": "electron .",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "lint": "eslint .",
    "test": "vitest run",
    "dist": "vite build && electron-builder --linux AppImage"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "eslint": "^9.15.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.15.0",
    "vite": "^5.4.11",
    "vitest": "^2.1.5",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.gatesenman.ontology-studio",
    "productName": "Ontology Studio",
    "files": [
      "dist/**",
      "electron/**"
    ],
    "icon": "build/icon.png",
    "linux": {
      "target": "AppImage",
      "category": "Development"
    }
  }
}
